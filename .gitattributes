# Keep development files out of release archives. GitHub builds the zip that
# Composer (dist installs) and the plugin's own installer download with
# `git archive`, which honors export-ignore.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpcs.xml.dist     export-ignore
/phpunit.xml.dist   export-ignore
/CONTRIBUTING.md    export-ignore
/PLAN.md            export-ignore
